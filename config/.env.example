# MinIO credentials (change these outside local development)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-this-password

# Spark / S3A connection
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=change-this-password
S3_REGION=us-east-1
S3_BUCKET=olist-data

# Local path inside the Airflow container
OLIST_INPUT_DIR=/opt/airflow/data/olist
