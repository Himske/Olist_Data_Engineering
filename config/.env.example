# Hadoop WASB's built-in local emulator account (Azurite on localhost:10000).
AZURE_STORAGE_ACCOUNT=storageemulator
AZURE_STORAGE_CONTAINER=olist-data

# For Azure Blob Storage, set AZURE_STORAGE_ACCOUNT to your account name and
# provide AZURE_STORAGE_KEY through a secrets backend or environment variable.

# Optional Airflow failure email. SMTP credentials must be kept in the untracked
# root .env file or supplied through a secrets backend.
AIRFLOW_FAILURE_EMAIL=alerts@example.com
AIRFLOW__SMTP__SMTP_HOST=smtp.example.com
AIRFLOW__SMTP__SMTP_PORT=587
AIRFLOW__SMTP__SMTP_STARTTLS=true
AIRFLOW__SMTP__SMTP_SSL=false
AIRFLOW__SMTP__SMTP_USER=
AIRFLOW__SMTP__SMTP_PASSWORD=

# Local path inside the Airflow container
OLIST_INPUT_DIR=/opt/airflow/data/olist
